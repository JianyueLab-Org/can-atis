<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AssemblyName>atis-for-can</AssemblyName>
        <RootNamespace>Vatsim.Vatis</RootNamespace>
		<ApplicationIcon>Assets\MainIcon.ico</ApplicationIcon>
        <Version>1.0.0</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<ContentWithTargetPath Include="Assets\MainIcon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Assets\MainIcon.ico</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="can_mumble_worker.py">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>can_mumble_worker.py</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="mumblecompat.py">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>mumblecompat.py</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="requirements-mumble.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>requirements-mumble.txt</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="..\..\atis\opus.dll" Condition="Exists('..\..\atis\opus.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>opus.dll</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="Data\airports.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Data\airports.json</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<!-- Select the native library by target runtime so cross-compiling (e.g. publishing osx-* from Linux) picks the right one; fall back to the host OS when no RID is given. -->
	<PropertyGroup>
		<NativeAudioOs Condition="$(RuntimeIdentifier.StartsWith('win'))">win</NativeAudioOs>
		<NativeAudioOs Condition="$(RuntimeIdentifier.StartsWith('linux'))">linux</NativeAudioOs>
		<NativeAudioOs Condition="$(RuntimeIdentifier.StartsWith('osx'))">osx</NativeAudioOs>
		<NativeAudioOs Condition="'$(NativeAudioOs)' == '' And $([System.OperatingSystem]::IsWindows())">win</NativeAudioOs>
		<NativeAudioOs Condition="'$(NativeAudioOs)' == '' And $([System.OperatingSystem]::IsLinux())">linux</NativeAudioOs>
		<NativeAudioOs Condition="'$(NativeAudioOs)' == '' And $([System.OperatingSystem]::IsMacOS())">osx</NativeAudioOs>
	</PropertyGroup>

	<ItemGroup Condition="'$(NativeAudioOs)' == 'win'">
        <ContentWithTargetPath Condition="Exists('.\Voice\Audio\Native\win\NativeAudio.dll')" Include=".\Voice\Audio\Native\win\NativeAudio.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>NativeAudio.dll</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<!-- A source/Debug build may run without NativeAudio.dll (local audio is then disabled), but a published package
	     must not: it would start normally and simply have no audio, and nothing in the build would say so. -->
	<Target Name="RequireNativeAudioForPublish" BeforeTargets="PrepareForPublish"
			Condition="'$(NativeAudioOs)' == 'win' And !Exists('.\Voice\Audio\Native\win\NativeAudio.dll')">
		<Error Text="Voice\Audio\Native\win\NativeAudio.dll is missing. Build NativeAudio first (see README.md) before publishing; a package without it has no audio." />
	</Target>

	<ItemGroup Condition="'$(NativeAudioOs)' == 'linux'">
		<ContentWithTargetPath Include=".\Voice\Audio\Native\lin\libNativeAudio.so">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>libNativeAudio.so</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeAudioOs)' == 'osx'">
		<ContentWithTargetPath Include=".\Voice\Audio\Native\macos\libNativeAudio.dylib">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>libNativeAudio.dylib</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
		<PackageReference Include="Avalonia" Version="11.3.22" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
		<PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
		<PackageReference Include="Avalonia.Svg" Version="11.3.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
		<PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
		<PackageReference Include="Avalonia.Xaml.Behaviors" Version="11.3.0.6" />
		<PackageReference Include="Concentus" Version="2.2.2" />
		<PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
		<PackageReference Include="MessagePack" Version="3.1.10" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Jab" Version="0.12.0" PrivateAssets="all" />
		<PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
		<PackageReference Include="Slugify.Core" Version="5.1.1" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<PackageReference Include="Velopack" Version="1.2.161" />
		<PackageReference Include="WatsonWebsocket" Version="4.1.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vatsim.Network\Vatsim.Network.csproj" />
	</ItemGroup>
</Project>
