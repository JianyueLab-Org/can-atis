<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CanAtis.Ui.Controls"
        xmlns:components="using:CanAtis.Ui.Components"
        xmlns:vm="using:CanAtis.Ui.ViewModels"
        x:Class="CanAtis.Ui.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="500" MinWidth="760" MinHeight="400"
        SystemDecorations="None" WindowStartupLocation="CenterScreen"
        CanResize="True" PointerPressed="OnWindowPointerPressed"
        PointerMoved="OnWindowPointerMoved" PointerExited="OnWindowPointerExited"
        Background="{DynamicResource Brush.Bg.App}" Title="CAN ATIS" Icon="/Assets/MainIcon.ico"
        Topmost="{Binding IsTopMost, DataType=vm:TopMostViewModel, Source={x:Static vm:TopMostViewModel.Instance}}">
    <Border BorderBrush="{DynamicResource Brush.Border.Control}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <Border Classes="toolbar" PointerPressed="OnPointerPressed" DoubleTapped="OnDoubleTapped">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Theme="{StaticResource Dark}" Content="用户设置" Command="{Binding OpenSettingsDialogCommand}" />
                        <Button Theme="{StaticResource Dark}" Content="通播配置" Command="{Binding OpenProfileConfigurationWindowCommand}" />
                        <Border Width="1" Background="{DynamicResource Brush.Border.Control}" Margin="4,2" />
                        <ToggleButton Theme="{StaticResource BlueToggle}" Content="置顶" ToolTip.Tip="窗口始终在最前"
                                      Command="{Binding ToggleIsTopMost, DataType=vm:TopMostViewModel, Source={x:Static vm:TopMostViewModel.Instance}}"
                                      IsChecked="{Binding IsTopMost, Mode=OneWay, DataType=vm:TopMostViewModel, Source={x:Static vm:TopMostViewModel.Instance}}" />
                        <Button Theme="{StaticResource Dark}" Content="精简窗口" Command="{Binding InvokeMiniWindowCommand}" />
                        <Button Theme="{StaticResource Dark}" Content="日志" Click="OnOpenLogs" ToolTip.Tip="打开按日保存的日志文件夹" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="clock" Text="{Binding CurrentTime}" Margin="12,0" ToolTip.Tip="UTC 时间" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Theme="{StaticResource Dark}" Content="—" Width="26" Padding="0" Click="OnMinimizeWindow" ToolTip.Tip="最小化" />
                        <Button Theme="{StaticResource Dark}" Content="✕" Width="26" Padding="0" Command="{Binding EndClientSessionCommand}" ToolTip.Tip="退出" />
                    </StackPanel>
                </Grid>
            </Border>
            <controls:CustomTabControl Name="AtisStations" Grid.Row="1"
                                       Classes.top="{Binding StationListOnTop}"
                                       IsVisible="{Binding AtisStations.Count}"
                                       ItemsSource="{Binding AtisStations}" SelectedIndex="{Binding SelectedTabIndex}">
                <controls:CustomTabControl.Styles>
                    <Style Selector="controls|CustomTabControl.top /template/ ScrollViewer#StationNavigation">
                        <Setter Property="DockPanel.Dock" Value="Top" />
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                    </Style>
                    <Style Selector="controls|CustomTabControl.top">
                        <Setter Property="ItemsPanel">
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="controls|CustomTabControl.top controls|CustomTabItem /template/ TextBlock#PART_AtisIdentifier">
                        <Setter Property="Text" Value="{Binding Identifier, DataType=vm:AtisStationViewModel}" />
                    </Style>
                    <Style Selector="controls|CustomTabControl.top controls|CustomTabItem /template/ TextBlock#PART_AtisLetter">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </controls:CustomTabControl.Styles>
                <controls:CustomTabControl.ItemContainerTheme>
                    <ControlTheme TargetType="controls:CustomTabItem" BasedOn="{StaticResource {x:Type controls:CustomTabItem}}" />
                </controls:CustomTabControl.ItemContainerTheme>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="vm:AtisStationViewModel"><components:AtisStationView ViewModel="{Binding}" /></DataTemplate>
                </TabControl.ContentTemplate>
            </controls:CustomTabControl>
            <StackPanel Grid.Row="1" IsVisible="{Binding !AtisStations.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="当前配置文件没有通播席位" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" />
                <Button Theme="{StaticResource Dark}" Classes="primary" Content="打开通播配置" HorizontalAlignment="Center" Command="{Binding OpenProfileConfigurationWindowCommand}" />
            </StackPanel>
            <Border x:Name="Overlay" Grid.RowSpan="2" ZIndex="100" Background="{DynamicResource Brush.Bg.Overlay}" IsVisible="{Binding ShowOverlay}" />
        </Grid>
    </Border>
</Window>
